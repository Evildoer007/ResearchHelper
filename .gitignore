# ==== 凭证 / 密钥：绝不提交 ====
config.local.json
.env
*.key
*credentials*
# This is application source, never a credential value or local store.
!/core/src/researchhelper/credentials.py

# ==== 本地数据缓存（iFinD 配额有限，静态数据缓存到本地）====
data_cache/
*.parquet
*.pkl

# ==== 生成物 / 预览 ====
output/
tmp/
_preview_*
# 只忽略**根目录**的下划线临时脚本（_run*.py / _dbg*.py 这类一次性诊断脚本）。
# 不能写成 `_*.py`——那会连 `core/__init__.py` 一起误伤（它也以下划线开头），
# 包标识文件一旦漏传，别人 clone 下来 import 就会出问题。
/_*.py
/_*.pkl

# ==== 只留本地的工作文档 ====
# 设计与论点库的问题记录属于内部工作底稿，不随代码分发。
# 当前产品规范与开发指南按实际目录单独维护。
DESIGN.md
!/blueprint/DESIGN.md
论点库说明与问题.md

# ==== 第三方材料：绝不提交 ====
# references/ 只保留Skill公开运行指南，不放券商内部材料。
# 原件与内部工作材料放入sources或data/source-materials，不随代码分发。
/sources/
/data/source-materials/

# ==== Python ====
__pycache__/
*.pyc
.venv/
.release-venv/
.release-venv310/
venv/

# ==== ResearchHelper本地运行状态 ====
# 保留旧隔离状态的忽略规则，避免迁移后误提交。
# data/result和项目级Skill安装均属于本地资产，可能含行情与身份信息。
.optionhelper_venv/
.optionhelper/
/data/
/result/

# ==== 打包产物 ====
build/
dist/
*.spec

# Published snapshots are generated, immutable local artifacts.
/versions/
/.cache/
/.skills/
# This project-level discovery link targets a generated local installation.
# Keep source Skill metadata and other explicitly maintained skills trackable.
/.agents/skills/researchhelper
/.researchhelper/
# Generated local demos and abandoned design studies stay on this machine.
# The maintained frontend, report examples and controlled icons remain source.
/demo/
/assets/design/
/.impeccable/
# Native Windows build cache; not release source.
**/obj/
**/bin/
.DS_Store
